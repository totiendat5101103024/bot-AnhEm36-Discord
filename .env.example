# ─── Discord ───────────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=

# ─── Spotify (không bắt buộc — plugin tự scrape embed) ──────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Zotero ────────────────────────────────────────────────
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_CHANNEL_ID=

# ─── Deadline ──────────────────────────────────────────────
DEADLINE_CHANNEL_ID=

# ─── Tuỳ chọn ──────────────────────────────────────────────
# DEBUG=1 để log debug
DEBUG=
# Đường dẫn database (mặc định data/economy.db)
DB_PATH=
# Đường dẫn binary yt-dlp (mặc định node_modules/@distube/yt-dlp/bin/yt-dlp)
YTDLP_PATH=
# Số ngày giữ log bot-*.log trước khi đưa vào trash (mặc định 14)
LOG_KEEP_DAYS=
